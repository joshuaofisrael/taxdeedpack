{
  "name": "taxdeedpack",
  "version": "1.0.0",
  "private": true,
  "description": "Joshua Israel Ventures LLC \u2014 Tax Deed Due Diligence Research Pack storefront and fulfillment API",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:site": "npx --yes serve site -l 4173",
    "dev:worker": "wrangler dev --local --persist-to .wrangler/state",
    "db:init": "wrangler d1 execute taxdeedpack --local --file=worker/schema.sql && wrangler d1 execute taxdeedpack --local --file=worker/seed.sql",
    "sample:pdf": "tsx scripts/generate-sample-pdf.ts",
    "simulate:fulfill": "tsx scripts/simulate-fulfillment.ts",
    "compliance:scan": "tsx scripts/compliance-scan.ts",
    "deploy:worker": "wrangler deploy",
    "fulfill:github": "tsx scripts/fulfill-github-order.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250913.0",
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "3.114.15"
  },
  "dependencies": {
    "hono": "^4.9.8",
    "pdf-lib": "^1.17.1"
  }
}
